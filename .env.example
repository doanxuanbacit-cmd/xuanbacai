# Sao chép các biến này vào Vercel → Project → Settings → Environment Variables
# Tất cả đều TÙY CHỌN, nhưng cần ít nhất MỘT đích nhận lead (Supabase, n8n hoặc Telegram) để form hoạt động.

# Địa chỉ website (dùng cho canonical, sitemap, Open Graph)
SITE_URL=https://protonisf.com

# --- Nơi nhận lead ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
N8N_LEAD_WEBHOOK_URL=https://agentos84.app.n8n.cloud/webhook/protonisf-lead
N8N_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email xác nhận gửi khách (Resend, cần xác minh tên miền protonisf.com) ---
RESEND_API_KEY=
MAIL_FROM=Proton ISF <contact@protonisf.com>

# --- Chống spam (Cloudflare Turnstile) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Đặt lịch, phân tích (biến dùng lúc build → sửa xong cần Redeploy) ---
CALCOM_LINK=https://cal.com/protonisf/30min
GA4_ID=
META_PIXEL_ID=

# --- Nội dung cần xác minh (mục 2.7) — để trống = ẩn ---
SANDBOX_DECREE=

# --- Bảo vệ endpoint ghi log trạng thái khi dùng Vercel Cron ---
CRON_SECRET=
